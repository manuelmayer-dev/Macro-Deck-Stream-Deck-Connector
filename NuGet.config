<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Empty in a fresh clone. Holds a locally packed SDK while the one with key images is
             unpublished, see "Development" in README.md. Remove this source before a Store submission. -->
        <add key="local" value="./local-feed" />
    </packageSources>
</configuration>
